   `(marginalia-off                    ((t (:foreground ,gray5))))
   `(marginalia-type                   ((t (:foreground ,lack))))
   `(marginalia-version                ((t (:foreground ,gray6))))
   `(marginalia-true                   ((t (:foreground ,green))))
