;;; noir-theme.el --- Monochrome dark theme, Tonsky-flavored Lackluster port -*- lexical-binding: t; -*-
;;
;; Palette derived from slugbyte/lackluster.nvim (MIT, Slugbyte).
;; Color usage informed by https://tonsky.me/blog/syntax-highlighting/.
;;
;; SPDX-License-Identifier: MIT

;;; Commentary:
;; True-black backdrop. Highlights reserved for declarations and constants;
;; keywords, calls, and variable usages inherit the default face. Comments
;; are bright (yellow), not dimmed. Punctuation is greyed out.

;;; Code:

(deftheme noir "Monochrome dark theme; few colors, used on purpose.")

(let ((bg            "#000000")
      (bg-menu       "#0a0a0a")
      (bg-popup      "#0c0c0c")
      (bg-statusln   "#161616")
      (bg-whitespace "#121212")
      (gray1         "#080808")
      (gray2         "#191919")
      (gray3         "#2a2a2a")
      (gray4         "#444444")
      (gray5         "#555555")
      (gray6         "#7a7a7a")
      (gray7         "#aaaaaa")
      (gray8         "#cccccc")
      (lack          "#708090")
      (luster        "#deeeed")
      (orange        "#ffaa88")
      (yellow        "#abab77")
      (green         "#789978")
      (blue          "#7788aa")
      (red           "#d70000"))

  (custom-theme-set-faces
   'noir

   ;; ---- Core ----
   `(default              ((t (:foreground ,luster :background ,bg))))
   `(cursor               ((t (:background ,luster))))
   `(fringe               ((t (:foreground ,gray4 :background ,bg))))
   `(vertical-border      ((t (:foreground ,gray3 :background ,bg))))
   `(window-divider       ((t (:foreground ,gray3))))
   `(window-divider-first-pixel ((t (:foreground ,gray3))))
   `(window-divider-last-pixel  ((t (:foreground ,gray3))))
   `(region               ((t (:foreground ,bg :background ,gray8 :extend t))))
   `(secondary-selection  ((t (:background ,gray3 :extend t))))
   `(highlight            ((t (:background ,gray1))))
   `(hl-line              ((t (:background ,gray1 :extend t))))
   `(shadow               ((t (:foreground ,gray4))))
   `(trailing-whitespace  ((t (:background ,bg-whitespace))))
   `(whitespace-trailing  ((t (:background ,bg-whitespace))))
   `(whitespace-tab       ((t (:foreground ,gray3))))
   `(whitespace-space     ((t (:foreground ,gray3))))
   `(whitespace-newline   ((t (:foreground ,gray3))))

   ;; ---- Line numbers ----
   `(line-number              ((t (:foreground ,gray4 :background ,bg))))
   `(line-number-current-line ((t (:foreground ,gray7 :background ,bg :weight normal))))
   `(line-number-major-tick   ((t (:foreground ,gray5 :background ,bg))))
   `(line-number-minor-tick   ((t (:foreground ,gray4 :background ,bg))))

   ;; ---- Modeline ----
   `(mode-line            ((t (:foreground ,gray8 :background ,bg-statusln :box nil))))
